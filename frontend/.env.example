# URL of the deployed backend (FastAPI). Leave unset for local dev — api.js falls
# back to http://127.0.0.1:8000. On Vercel, set this as a Project Environment
# Variable (Settings -> Environment Variables) to your backend's public URL,
# e.g. https://agentmart-api.up.railway.app — no trailing slash.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Only needed if the backend has MERCHANT_API_KEY set (see backend/.env.example) —
# must match it exactly, or every /merchant/* dashboard call gets a 401. Leave unset
# if you haven't set MERCHANT_API_KEY on the backend. Note this ends up in the public
# JS bundle (Vite bakes VITE_ vars in at build time), so it deters casual/opportunistic
# access to the dashboard endpoints, not a determined attacker with devtools open.
VITE_MERCHANT_API_KEY=
