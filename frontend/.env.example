# URL of the deployed backend (FastAPI). Leave unset for local dev — api.js falls
# back to http://127.0.0.1:8000. On Vercel, set this as a Project Environment
# Variable (Settings -> Environment Variables) to your backend's public URL,
# e.g. https://agentmart-api.up.railway.app — no trailing slash.
VITE_BACKEND_URL=http://127.0.0.1:8000
