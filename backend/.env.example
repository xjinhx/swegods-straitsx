MERCHANT_NAME=AgentMart
DATABASE_URL=sqlite:///./agentmart.db

# Ed25519 issuer keypair (app/security.py) — generate with:
#   cd backend && .venv/Scripts/python.exe scripts/generate_issuer_keypair.py
# Never commit issuer_private_key.pem (see .gitignore).
ISSUER_PRIVATE_KEY_PATH=./issuer_private_key.pem
ISSUER_PUBLIC_KEY_PATH=./issuer_public_key.pem

# StraitsX card-issuing MCP. Keep MOCK_STRAITSX=true until you're ready
# to sign real transfers. STRAITSX_PROFILE defaults to "production" (hackathon
# requirement — real $XSGD on Avalanche C-Chain Mainnet); set to "sandbox" for local
# testing on Fuji.
MOCK_STRAITSX=true
STRAITSX_PROFILE=production

# Wallet that signs the EIP-3009 TransferWithAuthorization paying the x402 challenge
# returned by StraitsX's cardapi. Must hold real XSGD on
# Avalanche C-Chain if STRAITSX_PROFILE=production.
STRAITSX_WALLET_ADDRESS=0xYourWalletAddressHere
STRAITSX_WALLET_PRIVATE_KEY=0xYourPrivateKeyHere

# Add your Vercel deployment URL(s) once the frontend is deployed, e.g.:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://agentmart.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gates the merchant dashboard endpoints (/merchant/*: revoke, override, rule builder).
# Leave unset to leave the gate off (agent-facing /identify, /checkout, /authorise are
# unaffected either way — trust scoring is the gate there, by design). Set a random
# string here and the matching VITE_MERCHANT_API_KEY in frontend/.env to turn it on.
MERCHANT_API_KEY=
