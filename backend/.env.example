MERCHANT_NAME=AgentMart
DATABASE_URL=sqlite:///./agentmart.db
JWT_SECRET=dev-secret-change-me

# StraitsX card-issuing MCP (PRD Section 9). Keep MOCK_STRAITSX=true until
# backend/scripts/discover_straitsx_mcp.py has confirmed the real tool name/schema.
MOCK_STRAITSX=true
STRAITSX_PROFILE=sandbox

# Sandbox wallet used to sign the EIP-3009 TransferWithAuthorization that pays
# the x402 challenge returned by StraitsX's cardapi (PRD Section 9.1/9.2).
STRAITSX_WALLET_ADDRESS=0xYourWalletAddressHere
STRAITSX_WALLET_PRIVATE_KEY=0xYourPrivateKeyHere

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
