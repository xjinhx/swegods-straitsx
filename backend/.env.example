MERCHANT_NAME=AgentMart
DATABASE_URL=sqlite:///./agentmart.db
JWT_SECRET=dev-secret-change-me

# StraitsX card-issuing MCP (PRD Section 9). Keep MOCK_STRAITSX=true until you're ready
# to sign real transfers. STRAITSX_PROFILE defaults to "production" (hackathon
# requirement — real $XSGD on Avalanche C-Chain Mainnet); set to "sandbox" for local
# testing on Fuji.
MOCK_STRAITSX=true
STRAITSX_PROFILE=production

# Wallet that signs the EIP-3009 TransferWithAuthorization paying the x402 challenge
# returned by StraitsX's cardapi (PRD Section 9.1/9.2). Must hold real XSGD on
# Avalanche C-Chain if STRAITSX_PROFILE=production.
STRAITSX_WALLET_ADDRESS=0xYourWalletAddressHere
STRAITSX_WALLET_PRIVATE_KEY=0xYourPrivateKeyHere

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
